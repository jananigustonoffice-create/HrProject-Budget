@model BudgetMaster
@{ ViewData["Title"] = "Budget"; }
<div class="page-head"><div><h3>@(Model.Id == 0 ? "New" : "Edit") Budget</h3></div></div>
<form asp-action="Save" method="post" class="card-x" style="max-width:520px">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <div class="mb-3"><label asp-for="FactoryId" class="form-label"></label><select asp-for="FactoryId" asp-items="ViewBag.Factories" class="form-select"></select></div>
    <div class="mb-3"><label asp-for="SectionId" class="form-label"></label><select asp-for="SectionId" asp-items="ViewBag.Sections" class="form-select"></select></div>
    <div class="mb-3"><label asp-for="Budget" class="form-label"></label><input asp-for="Budget" class="form-control" /><span asp-validation-for="Budget" class="text-danger"></span></div>
    <div class="mb-3">
        <label class="form-label" for="effectiveFrom">Applies from</label>
        <input type="date" id="effectiveFrom" name="effectiveFrom" class="form-control" value="@(Model.Id == 0 ? "" : DateTime.Today.ToString("yyyy-MM-dd"))" />
        <div class="form-text">The new budget counts <b>from this date onwards</b>. Days before it keep the budget they already had.@(Model.Id == 0 ? " Leave empty to use it for all days." : "")</div>
    </div>
    <button class="btn btn-primary">Save</button> <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
@if (ViewBag.History is List<BudgetHistory> hist && hist.Count > 0)
{
    <div class="card-x mt-3" style="max-width:520px">
        <h6 class="mb-2">Budget history</h6>
        <table class="table table-sm mb-0">
            <thead><tr><th>Applies from</th><th class="text-end">Budget</th></tr></thead>
            <tbody>
            @foreach (var h in hist)
            {
                <tr><td>@(h.EffectiveFrom.Year <= 2000 ? "The beginning" : h.EffectiveFrom.ToString("dd MMM yyyy"))</td><td class="text-end fw-semibold">@h.Budget</td></tr>
            }
            </tbody>
        </table>
    </div>
}
