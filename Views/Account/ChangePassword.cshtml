@model ChangePasswordModel
@{ ViewData["Title"] = "Change password"; }
<div class="page-head"><div><h3>Change password</h3><p>Choose a strong password you don't use elsewhere. @PasswordPolicy.Rule</p></div></div>
<form method="post" asp-action="ChangePassword" class="card-x" style="max-width:480px">
    <div class="mb-3"><label asp-for="Current" class="form-label"></label><input asp-for="Current" class="form-control" autocomplete="current-password" /><span asp-validation-for="Current" class="text-danger small"></span></div>
    <div class="mb-3"><label asp-for="New" class="form-label"></label><input asp-for="New" class="form-control" autocomplete="new-password" /><span asp-validation-for="New" class="text-danger small"></span></div>
    <div class="mb-4"><label asp-for="Confirm" class="form-label"></label><input asp-for="Confirm" class="form-control" autocomplete="new-password" /><span asp-validation-for="Confirm" class="text-danger small"></span></div>
    <button class="btn btn-primary">Update password</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
