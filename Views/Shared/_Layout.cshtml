@using System.Security.Claims
@{
    var u = Access.User;
    var ctrl = (string?)ViewContext.RouteData.Values["controller"] ?? "";
    string Act(string c) => string.Equals(ctrl, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var initials = string.Concat((u?.FullName ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));
    var roleText = u?.Role switch { HrProject_Budget.Models.Role.Admin => "Administrator", HrProject_Budget.Models.Role.SuperUser => "Super User (view only)", _ => "User" };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cadre Management</title>
    <link rel="icon" type="image/png" href="~/img/logo-teal.png" />
    <link rel="stylesheet" href="~/lib/inter/inter.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <aside class="sidebar" id="sidebar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <img class="brand-logo" src="~/img/logo-teal.png" alt="Concord Group" />
            <span><b>Concord Group</b><small>Cadre Management</small></span>
        </a>
        <nav>
            <a class="side-link @Act("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a>

            @if (Access.CanView("Entry") || Access.CanView("Report"))
            {
                <div class="nav-label">Operations</div>
                @foreach (var s in HrProject_Budget.Data.Screens.All.Where(s => s.Key is "Entry" or "Report" && Access.CanView(s.Key)))
                {
                    <a class="side-link @Act(s.Controller)" asp-controller="@s.Controller" asp-action="Index"><i class="bi bi-@s.Icon"></i> @s.Label</a>
                }
            }
            @if (HrProject_Budget.Data.Screens.All.Any(s => s.Key is not ("Entry" or "Report") && Access.CanView(s.Key)))
            {
                <div class="nav-label">Master Data</div>
                @foreach (var s in HrProject_Budget.Data.Screens.All.Where(s => s.Key is not ("Entry" or "Report") && Access.CanView(s.Key)))
                {
                    <a class="side-link @Act(s.Controller)" asp-controller="@s.Controller" asp-action="Index"><i class="bi bi-@s.Icon"></i> @s.Label</a>
                }
            }
            @if (Access.IsAdmin)
            {
                <div class="nav-label">Administration</div>
                <a class="side-link @Act("Users")" asp-controller="Users" asp-action="Index"><i class="bi bi-people"></i> Users &amp; Access</a>
                <a class="side-link @Act("Audit")" asp-controller="Audit" asp-action="Index"><i class="bi bi-clock-history"></i> Activity Log</a>
            }
            <div class="nav-label">Help</div>
            <a class="side-link @Act("Guide")" asp-controller="Guide" asp-action="Index"><i class="bi bi-book"></i> User Guide</a>
        </nav>
        <div class="side-foot">
            <div class="side-user">
                <span class="avatar">@initials</span>
                <div><b>@u?.FullName</b><small>@roleText</small></div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline"><button type="submit" class="btn btn-link p-0 border-0" style="color:inherit" title="Sign out" aria-label="Sign out"><i class="bi bi-box-arrow-right"></i></button></form>
            </div>
        </div>
    </aside>

    <div class="main">
        <header class="topbar">
            <button class="menu-btn" type="button" onclick="toggleSide()"><i class="bi bi-list fs-5"></i></button>
            <div class="crumbs"><span>Concord Group</span><i class="bi bi-chevron-right"></i><b>@ViewData["Title"]</b></div>
            <span class="today"><i class="bi bi-calendar3"></i> @DateTime.Today.ToString("ddd, dd MMM yyyy")</span>
            <button type="button" id="helpBtn" title="Help for this screen"><i class="bi bi-question-circle-fill"></i><span>Help</span></button>
            <div class="dropdown">
                <div class="user-chip" data-bs-toggle="dropdown" role="button">
                    <span class="avatar">@initials</span>
                    <span class="who"><b>@u?.FullName</b><small>@roleText</small></span>
                    <i class="bi bi-chevron-down text-muted"></i>
                </div>
                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" style="border-radius:14px">
                    <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2"></i>Change password</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button></form></li>
                </ul>
            </div>
        </header>
        <main class="content">
            <partial name="_Alerts" />
            @RenderBody()
        </main>
        <footer class="footer-x">&copy; 2026 Concord Group &middot; Cadre Management System</footer>
    </div>

    <partial name="_Help" />
    <script>
        // Sidebar: slide-over on mobile, hide/show on desktop (choice is remembered).
        try { if (localStorage.getItem('sideOff') === '1') document.body.classList.add('side-off'); } catch (e) { }
        function toggleSide() {
            if (window.innerWidth < 992) { document.getElementById('sidebar').classList.toggle('open'); return; }
            const off = document.body.classList.toggle('side-off');
            try { localStorage.setItem('sideOff', off ? '1' : '0'); } catch (e) { }
        }
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

