@model ReportViewModel
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = "Report";
    var main = Model.Rows.Where(r => !r.Separate).ToList();
    var separate = Model.Rows.Where(r => r.Separate).GroupBy(r => r.Department).ToList();
    int cols = 1 + 5 * (Model.Factories.Count + 1);

    ReportCell Sum(IEnumerable<ReportRow> rs, int? fid) => new ReportCell
    {
        Budget = rs.Sum(r => r.Cells.Where(k => fid == null || k.Key == fid).Sum(k => k.Value.Budget)),
        Allocated = rs.Sum(r => r.Cells.Where(k => fid == null || k.Key == fid).Sum(k => k.Value.Allocated)),
        Absent = rs.Sum(r => r.Cells.Where(k => fid == null || k.Key == fid).Sum(k => k.Value.Absent))
    };
    string Sf(int v) => v < 0 ? "neg" : v > 0 ? "pos" : "zero";

    // Five narrow cells (Budget, Allocated, Ab, Present, Shortage) for one factory, or for the group when fid is null.
    HtmlString Block(ReportCell c, string cls)
    {
        if (c.Budget == 0 && c.Allocated == 0)
            return new HtmlString($"<td class=\"{cls} gs dim\">–</td><td class=\"{cls} dim\">–</td><td class=\"{cls} dim\">–</td><td class=\"{cls} dim\">–</td><td class=\"{cls} dim\">–</td>");
        string N(int v) => v == 0 ? "<span class=\"dim\">–</span>" : v.ToString();
        return new HtmlString($"<td class=\"{cls} gs\">{N(c.Budget)}</td><td class=\"{cls}\">{N(c.Allocated)}</td><td class=\"{cls}\">{N(c.Absent)}</td><td class=\"{cls}\">{N(c.Present)}</td><td class=\"{cls}\"><span class=\"sf {Sf(c.Shortage)}\">{c.Shortage}</span></td>");
    }
    HtmlString Cells(Func<int?, ReportCell> get)
    {
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < Model.Factories.Count; i++) sb.Append(Block(get(Model.Factories[i].Id), "g" + (i % 5)).Value);
        sb.Append(Block(get(null), "gg").Value);
        return new HtmlString(sb.ToString());
    }
    var all = Sum(main, null);
}
<div class="page-head">
    <div><h3>Budgeted &amp; Actual MO/TMO Cadre</h3><p>@Model.Date.ToString("dddd, dd MMMM yyyy")</p></div>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <a class="btn btn-success" asp-action="Export" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")"><i class="bi bi-file-earmark-excel me-1"></i>Download Excel</a>
        <form method="get"><input type="date" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" class="form-control" style="width:170px" onchange="this.form.submit()" /></form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-xl-3"><div class="kpi kpi-1"><small>Group budget</small><div class="num">@all.Budget.ToString("N0")</div><i class="bi bi-bullseye"></i></div></div>
    <div class="col-6 col-xl-3"><div class="kpi kpi-2"><small>Allocated</small><div class="num">@all.Allocated.ToString("N0")</div><i class="bi bi-people"></i></div></div>
    <div class="col-6 col-xl-3"><div class="kpi kpi-3"><small>Present</small><div class="num">@all.Present.ToString("N0")</div><i class="bi bi-person-check"></i></div></div>
    <div class="col-6 col-xl-3"><div class="kpi kpi-4 @(all.Shortage >= 0 ? "ok" : "")"><small>@(all.Shortage >= 0 ? "Surplus" : "Shortage")</small><div class="num">@all.Shortage.ToString("N0")</div><i class="bi bi-@(all.Shortage >= 0 ? "check-circle" : "exclamation-triangle")"></i></div></div>
</div>

<div class="rep-card">
<table class="rep-one">
    <colgroup><col class="c-sec" />@for (int i = 0; i < cols - 1; i++) { <col /> }</colgroup>
    <thead>
        <tr class="top">
            <th class="sec" rowspan="2">Section</th>
            @for (int i = 0; i < Model.Factories.Count; i++) { <th colspan="5" class="h@(i % 5)" title="@Model.Factories[i].FullName">@Model.Factories[i].Name</th> }
            <th colspan="5" class="hg">Group Total</th>
        </tr>
        <tr class="sub2">
            @for (int k = 0; k <= Model.Factories.Count; k++) { <th class="gs">Bud</th><th>Alloc</th><th>Ab</th><th>Pres</th><th>Short</th> }
        </tr>
    </thead>
    <tbody>
    @foreach (var g in main.GroupBy(r => r.Department))
    {
        <tr class="band"><td colspan="@cols">@g.Key</td></tr>
        foreach (var r in g)
        {
            <tr><td>@r.Section</td>@Cells(fid => fid == null ? Sum(new[] { r }, null) : r.Cells[fid.Value])</tr>
        }
        <tr class="sub"><td>Sub Total</td>@Cells(fid => Sum(g, fid))</tr>
    }
    @if (main.Count > 0)
    {
        <tr class="grand"><td>Grand Total</td>@Cells(fid => Sum(main, fid))</tr>
    }
    @foreach (var g in separate)
    {
        <tr class="gap"><td colspan="@cols"></td></tr>
        <tr class="band"><td colspan="@cols">@g.Key</td></tr>
        foreach (var r in g)
        {
            <tr><td>@r.Section</td>@Cells(fid => fid == null ? Sum(new[] { r }, null) : r.Cells[fid.Value])</tr>
        }
        <tr class="grand"><td>Grand Total</td>@Cells(fid => Sum(g, fid))</tr>
    }
    </tbody>
</table>
</div>

@section Scripts {
<script>
    // On this wide table, start with the sidebar hidden on screens narrower than 1700px (unless the user chose otherwise).
    try { if (localStorage.getItem('sideOff') === null && window.innerWidth < 1700) document.body.classList.add('side-off'); } catch (e) { }
</script>
}
